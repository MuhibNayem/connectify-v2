# ---
# Universal Notification Service – Example Environment File
# Rename to `.env` or `.env.local` and adjust values before running the service.
# NOTE: Do NOT commit files containing real secrets.
# ---

# === Server ===
SERVER_PORT=8090
GRPC_PORT=9090
ENVIRONMENT=development

# === Storage (choose one) ===
STORAGE_TYPE=postgres               # postgres | mongodb | memory
STORAGE_URI=postgres://notif:notif@localhost:5432/notifications?sslmode=disable
STORAGE_DATABASE=notifications      # used when STORAGE_TYPE=mongodb
STORAGE_COLLECTION=notifications

# === Queue (choose one) ===
QUEUE_TYPE=kafka                    # kafka | rabbitmq | memory
QUEUE_BROKERS=localhost:9092
QUEUE_TOPIC=notifications
QUEUE_GROUP_ID=notification-service

# === Redis (required for idempotency / rate limiting / scheduler / websockets) ===
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# === Object Storage (used by storage-service for presigned URLs) ===
STORAGE_ENDPOINT=minio:9000               # internal host used by storage-service
# STORAGE_SIGNER_ENDPOINT=minio:9000        # optional override; defaults to STORAGE_ENDPOINT (internal dial target while URLs use STORAGE_PUBLIC_URL).
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=connectify-uploads
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000  # exposed host returned to clients

# === Authentication & Authorization ===
JWT_SECRET=dev-secret               # for HS256 tokens
# JWT_PUBLIC_KEY=/path/to/public.pem  # optional for RS256
API_KEYS=dev-key:internal-service   # comma-separated key:name pairs

# === Rate Limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_HOUR=3600        # converted to ~1 req/sec with 2x burst

# === Channels ===
# Email (SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-key
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Example Notifications"
SMTP_USE_TLS=true

# SMS (Twilio example)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push (FCM / APNS)
PUSH_ENABLED=false
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS=                      # raw JSON or file contents
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_KEY_FILE=

# In-App / WebSocket
INAPP_ENABLED=true
INAPP_WORKER_COUNT=10
INAPP_QUEUE_SIZE=10000

# === Observability ===
METRICS_ENABLED=true
METRICS_PORT=9102
TRACING_ENABLED=false
JAEGER_ENDPOINT=
LOG_LEVEL=info
LOG_FORMAT=json

# === Misc ===
USER_SERVICE_URL=http://localhost:8081        # optional user resolver
